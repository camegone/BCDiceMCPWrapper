name: Publish Package

on:
  push:
    tags:
      - 'v*' # tags like "v1.0.0"

jobs:
  publish:
    runs-on: ubuntu-latest

  permissions:
    id-token: write # allow OIDC token generation
    contents: read

  steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: 'lts/*'
        registry-url: 'https://registry.npmjs.com'

    - name: Install dependencies
      run: npm ci

    - name: Build package
      run: npm run build

    - name: Publish to npm
      run: npm stage publish --provenance
